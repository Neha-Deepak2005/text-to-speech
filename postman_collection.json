    {
      "name": "Generate Speech - With Auto-Translate",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Welcome to our application.\",\n  \"language\": \"hi\",\n  \"voice\": \"hi-standard\",\n  \"auto_translate\": true\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/tts", "host": ["{{baseUrl}}"], "path": ["api", "tts"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response includes translated_text', () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.be.true;",
              "  pm.expect(json.translated_text).to.be.a('string');",
              "  pm.expect(json.original_text).to.eql('Welcome to our application.');",
              "});"
            ]
          }
        }
      ]
    },
