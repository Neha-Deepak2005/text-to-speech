# Copy this file to .env and adjust values as needed.
# .env is git-ignored — never commit real secrets.

# Flask
FLASK_DEBUG=True
PORT=5000

# Comma-separated list of frontend origin(s) allowed to call this API (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Maximum characters accepted per text-to-speech request
MAX_TEXT_LENGTH=500

# How long generated audio files are kept before automatic cleanup (minutes)
AUDIO_RETENTION_MINUTES=30

# Rate limit applied to POST /api/tts (flask-limiter syntax)
RATE_LIMIT_TTS=10 per minute
